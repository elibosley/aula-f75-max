--- a/builddeps/chibios-contrib/os/hal/ports/SN32/LLD/SN32F2xx/SysTick/hal_st_lld.h
+++ b/builddeps/chibios-contrib/os/hal/ports/SN32/LLD/SN32F2xx/SysTick/hal_st_lld.h
@@ -32,6 +32,7 @@
 /*===========================================================================*/
 #define SN32_TIM_CT16B0 0
 #define SN32_TIM_CT16B1 1
+#define SN32_TIM_CT16B4 4
 
 /*===========================================================================*/
 /* Driver pre-compile time settings.                                         */
@@ -92,6 +93,16 @@
 #define SN32_ST_TIM                         SN32_CT16B1
 #define ST_LLD_NUM_ALARMS                   1
 
+#elif SN32_ST_USE_TIMER == SN32_TIM_CT16B4
+#if !defined(SN32_HAS_CT16B4) || !SN32_HAS_CT16B4
+#error "CT16B4 not present in the selected device"
+#endif
+#if defined(SN32_CT16B4_IS_USED)
